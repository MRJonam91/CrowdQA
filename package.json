{
  "name": "crowdqa",
  "version": "0.1.0",
  "description": "Structured crowd testing and human QA engine: campaign orchestrator, tester consent/NDA generator, bug intake with PII redaction, clustering, and audit report synthesis.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/CrowdQA#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/CrowdQA.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/CrowdQA/issues"
  },
  "keywords": [
    "crowdqa",
    "qa",
    "human-testing",
    "crowd-testing",
    "audit-report",
    "bug-tracking",
    "pii-redaction",
    "quality-assurance",
    "ux-testing",
    "nda-consent",
    "typescript",
    "zero-dependencies"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "crowdqa": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "CLA.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node dist/cli/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
